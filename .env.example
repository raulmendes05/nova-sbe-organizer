# Supabase — copia este ficheiro para .env.local e preenche
# (no dashboard do Supabase: Project Settings -> API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Cláudio (assistente) — chave da API do Google Gemini (aistudio.google.com/apikey)
# SEM prefixo VITE_ (fica só no servidor, nunca no browser).
GEMINI_API_KEY=...

# Provas antigas — Cloudflare R2 (dash.cloudflare.com -> R2 -> Manage API tokens)
# Guarda os PDFs. 10 GB grátis e, ao contrário do Supabase, sem custo de saída
# de dados — que é o que conta numa biblioteca só de descarregamentos.
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET=exams

# Só para a importação em massa (scripts/import-exams.mjs). NUNCA no browser:
# a service role key ignora as regras de RLS.
SUPABASE_SERVICE_ROLE_KEY=...
IMPORT_AS_EMAIL=o.teu.email@novasbe.pt

# Mensagens dos utilizadores (a aba de feedback) — email via Resend
# resend.com -> API Keys. Sem esta chave nada se perde: a mensagem continua a
# ser guardada no Supabase e a aparecer em /mensagens; so nao te chega email.
RESEND_API_KEY=re_...
# Para onde vao os avisos. OBRIGATORIO enquanto nao houver dominio verificado
# no Resend: sem dominio, ele so entrega no email da conta dona da chave, e
# qualquer outro destino leva 403.
FEEDBACK_TO=o.email.da.tua.conta.resend@exemplo.com
# Remetente. O onboarding@resend.dev so entrega na conta dona da chave e chega
# para comecar; com um dominio verificado no Resend, poe aqui o teu.
FEEDBACK_FROM=Nova SBE Organizer <onboarding@resend.dev>
